# Copy to .env and set for your environment.
# Values below match the app's own dev-safe defaults (see
# signal_flow_api_gateway/src/main/resources/application.properties), so
# `docker compose up postgres` + `mvn spring-boot:run` works unchanged.

# Postgres credentials and database name. The app authenticates as this user.
POSTGRES_USER=signal_flow
POSTGRES_PASSWORD=signal_flow
POSTGRES_DB=signal_flow

# Host port Postgres binds to for direct local access, bypassing the app.
# Not published by default (see docker-compose.yml) — uncomment there to use.
POSTGRES_PORT=

# Postgres credentials and database name for signal_flow_interest_topic_service's own container
# (postgres-topics). Separate from POSTGRES_* above — own container, own volume, own credentials.
TOPICS_POSTGRES_USER=signal_flow_topics
TOPICS_POSTGRES_PASSWORD=signal_flow_topics
TOPICS_POSTGRES_DB=signal_flow_topics
