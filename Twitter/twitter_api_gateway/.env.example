# Required: no usable default, set before starting
# 32+ bytes; the gateway refuses to start without it
JWT_SECRET=
# 32+ bytes, shared across services for /internal/v1/**
INTERNAL_API_SECRET=
# MinIO credentials (bucket created on startup if missing)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Required unless SEED_ENABLED=false: 12-72 bytes with a lowercase letter, an uppercase letter and a digit
SEED_PASSWORD=
SEED_PASSWORD_STILIYAN=
SEED_PASSWORD_KRISTIAN=
SEED_PASSWORD_GOSHO=
SEED_PASSWORD_GABI=

# Optional: commented values are the defaults from application.properties

# ---- App ----
# SERVER_PORT=8080

# ---- Postgres ----
# API_GATEWAY_DATASOURCE_URL=jdbc:postgresql://localhost:5432/twitter_api_gateway_db
# API_GATEWAY_DATASOURCE_USERNAME=
# API_GATEWAY_DATASOURCE_PASSWORD=

# ---- Security & Auth ----
# JWT_TTL=1h
# COOKIE_SECURE=true
# BCRYPT_STRENGTH=12

# ---- Request limits ----
# MAX_REQUEST_BODY_BYTES=8192
# MAX_UPLOAD_FILE_BYTES=5242880
# MAX_UPLOAD_BODY_BYTES=5308416
# MAX_TWEET_BODY_BYTES=21037056

# ---- Email confirmation ----
# CONFIRMATION_TTL=24h
# CONFIRMATION_RESEND_COOLDOWN=60s
# CONFIRMATION_LINK_BASE_URL=http://localhost:5173/confirm

# ---- Unconfirmed-user cleanup ----
# UNCONFIRMED_CLEANUP_CRON="0 0 4 * * *"
# UNCONFIRMED_CLEANUP_ZONE=Europe/Sofia
# UNCONFIRMED_CLEANUP_RETENTION=7d

# ---- Outbox ----
# OUTBOX_POLL_FIXED_DELAY_MS=3000
# OUTBOX_BATCH_SIZE=500
# OUTBOX_MAX_ATTEMPTS=3
# OUTBOX_SEND_TIMEOUT=10s

# ---- Kafka ----
# KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# USER_CONFIRMATION_REQUESTED_TOPIC_NAME=user.confirmation-requested
# USER_CONFIRMATION_REQUESTED_TOPIC_PARTITIONS=3
# USER_FOLLOWED_TOPIC_NAME=user.followed
# USER_FOLLOWED_TOPIC_PARTITIONS=3
# USER_UNFOLLOWED_TOPIC_NAME=user.unfollowed
# USER_UNFOLLOWED_TOPIC_PARTITIONS=3

# ---- MinIO ----
# MINIO_URL=http://localhost:9000
# MINIO_BUCKET=twitter-media
# MINIO_CONNECT_TIMEOUT=2s
# MINIO_IO_TIMEOUT=30s

# ---- Downstream services ----
# TWEET_SERVICE_URL=http://localhost:8081
# TIMELINE_SERVICE_URL=http://localhost:8083
# UPSTREAM_CONNECT_TIMEOUT=2s
# UPSTREAM_READ_TIMEOUT=10s

# ---- Demo data ----
# SEED_ENABLED=true
# SEED_PICTURES_DIR=./seed-images
