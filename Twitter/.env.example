# ---- Docker Compose (Postgres, MinIO, Mongo, Redis) ----
POSTGRES_USER=twitter
POSTGRES_PASSWORD=twitter
POSTGRES_DB=twitter_api_gateway_db
# Required, no default - compose refuses to start without it, and twitter_mail_service reads the same value
REDIS_PASSWORD=twitter-redis-secret
# twitter_timeline_service's own Postgres (host port 5433). User and password have no default
TIMELINE_POSTGRES_USER=twitter
TIMELINE_POSTGRES_PASSWORD=twitter
TIMELINE_POSTGRES_DB=twitter_timeline_service_db

# ---- twitter_api_gateway ----
# Datasource - defaults match the compose values above, so leave these commented out locally
# DATASOURCE_URL=jdbc:postgresql://localhost:5432/twitter_api_gateway_db
# DATASOURCE_USERNAME=twitter
# DATASOURCE_PASSWORD=twitter

# Security. JWT_SECRET has no default - the app refuses to start without it (32+ bytes for HS256)
JWT_SECRET=
JWT_TTL=1h
# Guards the gateway's /internal/v1/** endpoints. No default - the app refuses to start without it (32+ bytes);
# the timeline service sends the same value
INTERNAL_API_SECRET=
COOKIE_SECURE=false
BCRYPT_STRENGTH=12

# Request limits
MAX_REQUEST_BODY_BYTES=8192
# Picture uploads: the file cap, and the larger body cap for the two upload routes (file cap + multipart framing)
MAX_UPLOAD_FILE_BYTES=5242880
MAX_UPLOAD_BODY_BYTES=5308416
# Tweet creation: 4 images of 5 MB + 64 KB of multipart framing. Shared with twitter_tweet_service
MAX_TWEET_BODY_BYTES=21037056

# Tweet-service routing: where /api/v1/tweets/** is forwarded, and the upstream timeouts for every route
TWEET_SERVICE_URL=http://localhost:8081
# Timeline-service routing: where /api/v1/feed is forwarded
TIMELINE_SERVICE_URL=http://localhost:8083
UPSTREAM_CONNECT_TIMEOUT=2s
UPSTREAM_READ_TIMEOUT=10s

# Email confirmation
CONFIRMATION_TTL=24h
CONFIRMATION_RESEND_COOLDOWN=60s
CONFIRMATION_LINK_BASE_URL=http://localhost:5173/confirm

# Unconfirmed-user cleanup
UNCONFIRMED_CLEANUP_CRON="0 0 4 * * *"
UNCONFIRMED_CLEANUP_ZONE=Europe/Sofia
UNCONFIRMED_CLEANUP_RETENTION=7d

# Outbox
OUTBOX_POLL_FIXED_DELAY_MS=3000
OUTBOX_BATCH_SIZE=500
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_SEND_TIMEOUT=10s

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
USER_CONFIRMATION_REQUESTED_TOPIC_NAME=user.confirmation-requested
USER_CONFIRMATION_REQUESTED_TOPIC_PARTITIONS=3

# MinIO. The access and secret keys have no default - the app refuses to start without them, and compose
# uses the same pair as the MinIO root credentials (secret must be 8+ characters)
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=twitter
MINIO_SECRET_KEY=twitter-minio-secret
MINIO_BUCKET=twitter-media

# ---- twitter_tweet_service ----
# Port - leave commented out: the variable is shared with any other Spring Boot app started from this same
# .env, and would move it too. The service defaults to 8081
# SERVER_PORT=8081

# Mongo - the default matches the compose service, so leave it commented out locally
# MONGODB_URI=mongodb://localhost:27017/twitter_tweet_service_db?directConnection=true

# Request limits: MAX_REQUEST_BODY_BYTES, MAX_UPLOAD_FILE_BYTES and MAX_TWEET_BODY_BYTES above are shared with
# the gateway
# MAX_UPLOAD_FILES=4
# MAX_TWEET_CONTENT_CODE_POINTS=280

# Kafka topic
# TWEET_CREATED_TOPIC_NAME=tweet.created
# TWEET_DELETED_TOPIC_NAME=tweet.deleted
# TWEET_CREATED_TOPIC_PARTITIONS=3
# TWEET_DELETED_TOPIC_PARTITIONS=3

# MinIO: MINIO_URL / MINIO_ACCESS_KEY / MINIO_SECRET_KEY above are shared with the gateway. The bucket is the
# service's own (the gateway's MINIO_BUCKET is a different bucket)
TWEET_MINIO_BUCKET=tweet-images

# ---- twitter_mail_service ----
# Port - leave commented out: the variable is shared with any other Spring Boot app started from this same
# .env, and would move it too. The service defaults to 8082
# SERVER_PORT=8082

# Redis: REDIS_PASSWORD is above (shared with compose). Host and port default to the compose service
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Inbox: how long a claim holds the right to send, and how long a sent confirmation email is remembered
# MAIL_INBOX_CLAIM_TTL=5m
# CONFIRMATION_MAIL_SENT_TTL=7d
# One follow email per follower-followee pair per window. Must be positive - the app refuses to start otherwise
# FOLLOW_MAIL_WINDOW=24h

# SMTP - defaults to Gmail (smtp.gmail.com:587, auth and STARTTLS on). To send to Mailpit from compose
# instead, set MAIL_HOST=localhost, MAIL_PORT=1025, MAIL_SMTP_AUTH=false and MAIL_SMTP_STARTTLS=false
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_CONNECTION_TIMEOUT_MS=10000
# MAIL_SMTP_TIMEOUT_MS=10000
# MAIL_SMTP_WRITE_TIMEOUT_MS=10000

# Sender. MAIL_FROM has no default - the app refuses to start without it. With Gmail it must be the
# account or a verified alias
MAIL_FROM=twitter@example.com
MAIL_ZONE=Europe/Sofia
# Where the follow email's button points: APP_BASE_URL + /feed, so do not end it with a slash
# APP_BASE_URL=http://localhost:5173

# Kafka: USER_CONFIRMATION_REQUESTED_TOPIC_NAME, USER_FOLLOWED_TOPIC_NAME and KAFKA_BOOTSTRAP_SERVERS are shared
# with the gateway
# MAIL_LISTENER_CONCURRENCY=3
# USER_CONFIRMATION_REQUESTED_DLT_NAME=user.confirmation-requested-dlt
# USER_CONFIRMATION_REQUESTED_DLT_PARTITIONS=3
# USER_FOLLOWED_DLT_NAME=user.followed-dlt
# USER_FOLLOWED_DLT_PARTITIONS=3
# Blocking retries before a record is dead-lettered; each wait stays well under max.poll.interval.ms
# KAFKA_RETRY_INITIAL_INTERVAL=2s
# KAFKA_RETRY_MAX_INTERVAL=60s
# KAFKA_RETRY_MAX_RETRIES=8

# ---- twitter_timeline_service ----
# Port - leave commented out: the variable is shared with any other Spring Boot app started from this same
# .env, and would move it too. The service defaults to 8083
# SERVER_PORT=8083

# Datasource - the user and password must match TIMELINE_POSTGRES_USER / TIMELINE_POSTGRES_PASSWORD above. The
# names are prefixed because the gateway reads DATASOURCE_* from this same file
# TIMELINE_DATASOURCE_URL=jdbc:postgresql://localhost:5433/twitter_timeline_service_db
TIMELINE_DATASOURCE_USERNAME=twitter
TIMELINE_DATASOURCE_PASSWORD=twitter

# Kafka: KAFKA_BOOTSTRAP_SERVERS and the producers' topic names (TWEET_CREATED_TOPIC_NAME, TWEET_DELETED_TOPIC_NAME,
# USER_UNFOLLOWED_TOPIC_NAME) are shared with the tweet service and the gateway. Only the dead-letter topics are
# declared here
# TIMELINE_LISTENER_CONCURRENCY=3
# TWEET_CREATED_DLT_NAME=tweet.created-dlt
# TWEET_CREATED_DLT_PARTITIONS=3
# TWEET_DELETED_DLT_NAME=tweet.deleted-dlt
# TWEET_DELETED_DLT_PARTITIONS=3
# USER_UNFOLLOWED_DLT_NAME=user.unfollowed-dlt
# USER_UNFOLLOWED_DLT_PARTITIONS=3
# Blocking retries before a record is dead-lettered (KAFKA_RETRY_* are shared with the mail service)
# KAFKA_RETRY_INITIAL_INTERVAL=2s
# KAFKA_RETRY_MAX_INTERVAL=60s
# KAFKA_RETRY_MAX_RETRIES=8

# Feed retention: entries whose tweet is older than FEED_RETENTION are deleted by a nightly job, in batches. The
# retention must be positive and the batch size at least 1 - the app refuses to start otherwise
# FEED_RETENTION=7d
# FEED_CLEANUP_CRON="0 0 4 * * *"
# FEED_CLEANUP_ZONE=Europe/Sofia
# FEED_CLEANUP_BATCH_SIZE=10000

