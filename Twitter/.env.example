# Copy to .env. Lines without a leading "#" are required: fill them in.
# Lines starting with "#" are optional and fall back to the default in each service's application.properties.
# Leave an optional line commented out: an empty value overrides the default.
# Cron values contain spaces, so quote them (the file is sourced in a shell).

# ---- Docker Compose (Postgres, MinIO, Mongo, Redis) ----
POSTGRES_USER=
POSTGRES_PASSWORD=
# Defaults to twitter_api_gateway_db
POSTGRES_DB=
REDIS_PASSWORD=
# Defaults to twitter_timeline_service_db
# TIMELINE_POSTGRES_DB=

# ---- Production (docker-compose.prod.yml only) ----
# The public https origin, no trailing slash, e.g. https://twitter.example.com. The links in emails are built from it.
# MAIL_HOST, MAIL_USERNAME, MAIL_PASSWORD and MAIL_FROM are required there as well
# PUBLIC_URL=

# ---- twitter_api_gateway ----
# Datasource, set only when the gateway runs from the IDE (compose builds the URL itself)
# API_GATEWAY_DATASOURCE_URL=
# API_GATEWAY_DATASOURCE_USERNAME=
# API_GATEWAY_DATASOURCE_PASSWORD=

# 32+ bytes; the gateway refuses to start without it
JWT_SECRET=
# Token lifetime
# JWT_TTL=
# 32+ bytes, shared by the gateway and the timeline service
INTERNAL_API_SECRET=
# true unless set to false; plain-HTTP local use (Safari) needs false
# COOKIE_SECURE=
# BCRYPT_STRENGTH=
# Set to false to skip the demo users (then SEED_PASSWORD is not needed)
# SEED_ENABLED=
# Required unless SEED_ENABLED=false, no default: 12-72 bytes with a lowercase letter, an uppercase letter and a digit.
# Generate one with: openssl rand -base64 18
SEED_PASSWORD=
# SEED_PICTURES_DIR=

# MAX_REQUEST_BODY_BYTES=
# MAX_UPLOAD_FILE_BYTES=
# MAX_UPLOAD_BODY_BYTES=
# MAX_TWEET_BODY_BYTES=

# Where the gateway reaches the other services
# TWEET_SERVICE_URL=
# TIMELINE_SERVICE_URL=
# UPSTREAM_CONNECT_TIMEOUT=
# UPSTREAM_READ_TIMEOUT=

# CONFIRMATION_TTL=
# CONFIRMATION_RESEND_COOLDOWN=
# CONFIRMATION_LINK_BASE_URL=

# Cleanup of unconfirmed users; default cron is "0 0 4 * * *"
# UNCONFIRMED_CLEANUP_CRON="0 0 4 * * *"
# UNCONFIRMED_CLEANUP_ZONE=
# UNCONFIRMED_CLEANUP_RETENTION=

# Outbox poller, shared by the gateway and the tweet service
# OUTBOX_POLL_FIXED_DELAY_MS=
# OUTBOX_BATCH_SIZE=
# OUTBOX_MAX_ATTEMPTS=
# OUTBOX_SEND_TIMEOUT=

# KAFKA_BOOTSTRAP_SERVERS=
# USER_CONFIRMATION_REQUESTED_TOPIC_NAME=
# USER_CONFIRMATION_REQUESTED_TOPIC_PARTITIONS=
# Follow topics: the gateway publishes them, the timeline and mail services consume them (names are shared)
# USER_FOLLOWED_TOPIC_NAME=
# USER_FOLLOWED_TOPIC_PARTITIONS=
# USER_UNFOLLOWED_TOPIC_NAME=
# USER_UNFOLLOWED_TOPIC_PARTITIONS=

# MinIO, shared by the gateway and the tweet service (the secret needs 8+ characters)
# MINIO_URL=
# Client timeouts (defaults 2s connect, 30s read and write)
# MINIO_CONNECT_TIMEOUT=
# MINIO_IO_TIMEOUT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# MINIO_BUCKET=

# ---- twitter_tweet_service ----
# SERVER_PORT=

# MONGODB_URI=

# MAX_UPLOAD_FILES=
# MAX_TWEET_CONTENT_CODE_POINTS=

# TWEET_CREATED_TOPIC_NAME=
# TWEET_DELETED_TOPIC_NAME=
# TWEET_CREATED_TOPIC_PARTITIONS=
# TWEET_DELETED_TOPIC_PARTITIONS=

# TWEET_MINIO_BUCKET=

# Base URL of the gateway's internal API (tweet and timeline services). Compose sets it to http://gateway:8080
# GATEWAY_INTERNAL_URL=

# ---- twitter_mail_service ----
# SERVER_PORT=

# REDIS_HOST=
# REDIS_PORT=

# MAIL_INBOX_CLAIM_TTL=
# CONFIRMATION_MAIL_SENT_TTL=
# FOLLOW_MAIL_WINDOW=

# SMTP; compose uses Mailpit locally. Required in production
# MAIL_HOST=
# MAIL_PORT=
# MAIL_SMTP_AUTH=
# MAIL_SMTP_STARTTLS=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_CONNECTION_TIMEOUT_MS=
# MAIL_SMTP_TIMEOUT_MS=
# MAIL_SMTP_WRITE_TIMEOUT_MS=

# A valid email address; the mail service refuses to start without it
MAIL_FROM=
# Defaults to Europe/Sofia
# MAIL_ZONE=
# Required when the mail service runs from the IDE (the follow email links here); compose defaults it to this
APP_BASE_URL=http://localhost:5173

# MAIL_LISTENER_CONCURRENCY=
# USER_CONFIRMATION_REQUESTED_DLT_NAME=
# USER_CONFIRMATION_REQUESTED_DLT_PARTITIONS=
# USER_FOLLOWED_DLT_NAME=
# USER_FOLLOWED_DLT_PARTITIONS=
# Retry settings, shared by the mail and timeline services
# KAFKA_RETRY_INITIAL_INTERVAL=
# KAFKA_RETRY_MAX_INTERVAL=
# KAFKA_RETRY_MAX_RETRIES=

# ---- twitter_timeline_service ----
# SERVER_PORT=

# TIMELINE_DATASOURCE_URL=
TIMELINE_DATASOURCE_USERNAME=
TIMELINE_DATASOURCE_PASSWORD=

# Calls from the timeline service to the gateway (defaults 1s connect, 3s read)
# TIMELINE_HTTP_CONNECT_TIMEOUT=
# TIMELINE_HTTP_READ_TIMEOUT=

# TIMELINE_LISTENER_CONCURRENCY=
# TWEET_CREATED_DLT_NAME=
# TWEET_CREATED_DLT_PARTITIONS=
# TWEET_DELETED_DLT_NAME=
# TWEET_DELETED_DLT_PARTITIONS=
# USER_UNFOLLOWED_DLT_NAME=
# USER_UNFOLLOWED_DLT_PARTITIONS=
# TIMELINE_USER_FOLLOWED_DLT_NAME=
# TIMELINE_USER_FOLLOWED_DLT_PARTITIONS=

# FEED_BACKFILL_SIZE=
# FEED_RETENTION=
# Default cron is "0 0 4 * * *"
# FEED_CLEANUP_CRON="0 0 4 * * *"
# FEED_CLEANUP_ZONE=
# FEED_CLEANUP_BATCH_SIZE=
