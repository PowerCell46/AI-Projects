# ---- Docker Compose (Postgres, MinIO, Mongo) ----
POSTGRES_USER=twitter
POSTGRES_PASSWORD=twitter
POSTGRES_DB=twitter_api_gateway_db

# ---- twitter_api_gateway ----
# Datasource - defaults match the compose values above, so leave these commented out locally
# DATASOURCE_URL=jdbc:postgresql://localhost:5432/twitter_api_gateway_db
# DATASOURCE_USERNAME=twitter
# DATASOURCE_PASSWORD=twitter

# Security. JWT_SECRET has no default - the app refuses to start without it (32+ bytes for HS256)
JWT_SECRET=
JWT_TTL=1h
COOKIE_SECURE=false
BCRYPT_STRENGTH=12

# Request limits
MAX_REQUEST_BODY_BYTES=8192
# Picture uploads: the file cap, and the larger body cap for the two upload routes (file cap + multipart framing)
MAX_UPLOAD_FILE_BYTES=5242880
MAX_UPLOAD_BODY_BYTES=5308416

# Email confirmation
CONFIRMATION_TTL=24h
CONFIRMATION_RESEND_COOLDOWN=60s
CONFIRMATION_LINK_BASE_URL=http://localhost/confirm

# Unconfirmed-user cleanup
UNCONFIRMED_CLEANUP_CRON="0 0 4 * * *"
UNCONFIRMED_CLEANUP_ZONE=Europe/Sofia
UNCONFIRMED_CLEANUP_RETENTION=7d

# Outbox
OUTBOX_POLL_FIXED_DELAY_MS=3000
OUTBOX_BATCH_SIZE=500
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_SEND_TIMEOUT=10s

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
USER_CONFIRMATION_REQUESTED_TOPIC_NAME=user.confirmation-requested
USER_CONFIRMATION_REQUESTED_TOPIC_PARTITIONS=3

# MinIO. The access and secret keys have no default - the app refuses to start without them, and compose
# uses the same pair as the MinIO root credentials (secret must be 8+ characters)
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=twitter
MINIO_SECRET_KEY=twitter-minio-secret
MINIO_BUCKET=twitter-media

# ---- twitter_tweet_service ----
# Port - leave commented out: the variable is shared with any other Spring Boot app started from this same
# .env, and would move it too. The service defaults to 8081
# SERVER_PORT=8081

# Mongo - the default matches the compose service, so leave it commented out locally
# MONGODB_URI=mongodb://localhost:27017/twitter_tweet_service_db?directConnection=true

# Request limits: MAX_REQUEST_BODY_BYTES and MAX_UPLOAD_FILE_BYTES above are shared with the gateway. The tweet
# body cap is 4 images of 5 MB + 64 KB of multipart framing
# MAX_UPLOAD_FILES=4
# MAX_TWEET_BODY_BYTES=21037056
# MAX_TWEET_CONTENT_CODE_POINTS=280

# Kafka topic
# TWEET_CREATED_TOPIC_NAME=tweet.created
# TWEET_DELETED_TOPIC_NAME=tweet.deleted
# TWEET_CREATED_TOPIC_PARTITIONS=3
# TWEET_DELETED_TOPIC_PARTITIONS=3

# MinIO: MINIO_URL / MINIO_ACCESS_KEY / MINIO_SECRET_KEY above are shared with the gateway. The bucket is the
# service's own (the gateway's MINIO_BUCKET is a different bucket)
TWEET_MINIO_BUCKET=tweet-images
