# ---- App ----
# SERVER_PORT=8082

# ---- Kafka ----
# KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# MAIL_LISTENER_CONCURRENCY=3

# Main topics are owned by the gateway: keep the names identical to its env
# USER_CONFIRMATION_REQUESTED_TOPIC_NAME=user.confirmation-requested
# USER_FOLLOWED_TOPIC_NAME=user.followed

# USER_CONFIRMATION_REQUESTED_DLT_NAME=user.confirmation-requested-dlt
# USER_CONFIRMATION_REQUESTED_DLT_PARTITIONS=3
# USER_FOLLOWED_DLT_NAME=user.followed-dlt
# USER_FOLLOWED_DLT_PARTITIONS=3

# KAFKA_RETRY_INITIAL_INTERVAL=2s
# KAFKA_RETRY_MAX_INTERVAL=60s
# KAFKA_RETRY_MAX_RETRIES=8

# ---- Redis (mail inbox) ----
# REDIS_HOST=localhost
# REDIS_PORT=6379
REDIS_PASSWORD=

# MAIL_INBOX_CLAIM_TTL=2m
# CONFIRMATION_MAIL_SENT_TTL=7d
# FOLLOW_MAIL_WINDOW=24h

# ---- SMTP ----
# Defaults target Gmail (needs MAIL_USERNAME + an app password; both are required while MAIL_SMTP_AUTH is true).
# For Mailpit (UI on localhost:8025) set MAIL_HOST=localhost, MAIL_PORT=1025, MAIL_SMTP_AUTH=false, MAIL_SMTP_STARTTLS=false
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_CONNECTION_TIMEOUT_MS=10000
# MAIL_SMTP_TIMEOUT_MS=10000
# MAIL_SMTP_WRITE_TIMEOUT_MS=10000

# ---- Mail content ----
# Must be the Gmail account or a verified alias
MAIL_FROM=
# MAIL_ZONE=Europe/Sofia
# Required, no default: the follow email links here. An absolute http(s) URL; use https outside localhost
APP_BASE_URL=http://localhost:5173
