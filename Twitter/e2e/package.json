{
  "name": "twitter-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:fast": "E2E_NO_BUILD=1 playwright test",
    "test:headed": "playwright test --headed",
    "test:slow": "SLOWMO=1000 playwright test --headed --workers=1",
    "stack:down": "docker compose -p twitter-e2e -f docker-compose.e2e.yml down -v"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "typescript": "~6.0.2"
  }
}
