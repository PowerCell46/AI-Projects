.env
.env.local

# TLS certificate and key for docker-compose.prod.yml
certs/

# Demo profile pictures: photos of real people stay on the machine, because the repo is public and a committed file
# cannot be removed from history. The folder keeps only its README
twitter_api_gateway/seed-images/*
!twitter_api_gateway/seed-images/README.md

# Open and accepted security findings: the repo is public, and a committed file cannot be removed from history.
# The tracked audit documents keep only what is fixed
security-private/

# Editor / OS
.idea
.vscode/
.DS_Store
