# Copy to .env and set for your environment.

# Public IP of the server this stack is deployed to. Caddy uses it to get a
# real cert for <SERVER_IP>.nip.io via automatic HTTPS — no domain needed.
SERVER_IP=

# Public base URL embedded in every shortened link returned by the API.
# Defaults to the Caddy/nip.io origin built from SERVER_IP; override if you're
# fronting the stack differently (e.g. a real domain).
BASE_URL=

# Host ports app/frontend bind to for direct local access, bypassing Caddy.
# Not published by default (see docker-compose.yml) — uncomment there to use.
APP_PORT=
FRONTEND_PORT=

# Mongo database name.
MONGO_DB_NAME=

# Mongo root credentials (bootstraps the root user on first init — only takes
# effect on a fresh mongo_data volume). The app authenticates as this user.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# Redis password (--requirepass). The app authenticates with this.
REDIS_PASSWORD=
