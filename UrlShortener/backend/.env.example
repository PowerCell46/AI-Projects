# Copy to .env and fill in per environment. Every var below has a
# localhost/dev-safe default baked into application.properties, so none of
# these are required to run locally — set them explicitly for anything
# beyond local dev.

# MongoDB connection string (source of truth)
MONGODB_URI=

# Redis - TTL cache on the redirect path only
REDIS_HOST=
REDIS_PORT=

# Public base URL the returned short link is built from.
# Must be the real, internet-facing origin in any deployed environment -
# never leave this as localhost outside local dev.
BASE_URL=

# Redirect-cache TTL (Redis-only; Mongo documents never expire). Accepts
# Spring Duration shorthand, e.g. 1h, 30m, 45s.
CACHE_TTL=

# Snowflake id generation. Must be unique per running instance when scaling
# horizontally - two instances sharing worker+datacenter id can collide.
SNOWFLAKE_WORKER_ID=
SNOWFLAKE_DATACENTER_ID=

# Server port
SERVER_PORT=
